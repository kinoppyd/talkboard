+#endif
     usb_cdc_drain();
     in_usb_pump = false;
     mutex_exit(&usb_mutex);
@@ -361,6 +367,9 @@ picorb_hal_init(void)
   irq_set_enabled((uint)usb_pump_irq_num, true);
 
   tud_init(TUD_OPT_RHPORT);
+#ifdef TALKBOARD_RELAY
+  relay_start();
+#endif
   irq_add_shared_handler(USBCTRL_IRQ, usb_irq_handler,
       PICO_SHARED_IRQ_HANDLER_LOWEST_ORDER_PRIORITY);
 }
@@ -472,6 +481,9 @@ picorb_hal_cdc_write(uint8_t itf, const void *buf, int nbytes, uint32_t timeout_
       }
       in_usb_pump = true;
       tud_task();
+#ifdef TALKBOARD_RELAY
+    relay_device_task();
+#endif
       in_usb_pump = false;
       tud_cdc_n_write_flush(itf);
     }
@@ -630,6 +642,9 @@ Machine_tud_task(void)
   if (mutex_enter_timeout_ms(&usb_mutex, 10)) {
     in_usb_pump = true;
     tud_task();
+#ifdef TALKBOARD_RELAY
+    relay_device_task();
+#endif
     usb_cdc_drain();
     in_usb_pump = false;
     mutex_exit(&usb_mutex);
