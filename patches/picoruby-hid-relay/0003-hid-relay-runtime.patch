new file mode 100644
index 00000000..78c94514
--- /dev/null
+++ b/mrbgems/picoruby-hid-relay/include/hid_relay.h
@@ -0,0 +1,9 @@
+#pragma once
+#include <stdbool.h>
+#include <stdint.h>
+typedef struct { uint32_t ms, generation; uint8_t key, modifiers; } relay_event;
+void relay_start(void);
+void relay_device_task(void);
+bool relay_read_event(relay_event *);
+uint32_t relay_generation(void);
+uint32_t relay_errors(void);
diff --git a/mrbgems/picoruby-hid-relay/ports/rp2040/hid_relay.c b/mrbgems/picoruby-hid-relay/ports/rp2040/hid_relay.c
new file mode 100644
index 00000000..598596b0
--- /dev/null
+++ b/mrbgems/picoruby-hid-relay/ports/rp2040/hid_relay.c
@@ -0,0 +1,194 @@
+#ifdef TALKBOARD_RELAY
+#include "../../include/hid_relay.h"
+#include "../../include/relay_core.h"
+#include "pico/stdlib.h"
+#include "pico/multicore.h"
+#include "hardware/dma.h"
+#include "hardware/sync.h"
+#include "pio_usb.h"
+#include "tusb.h"
+#include <string.h>
+#define PORTS 4
+#define FRAMES 32
+#define EVENTS 128
+typedef struct { relay_state state; uint32_t ms; } frame;
+typedef struct {
+  relay_layout layout;
+  relay_state reports[RELAY_REPORTS];
+  uint8_t addr, instance, led_id, led_buf[64], sent_led;
+  bool active, pending, led_busy, led_valid;
+} port;
+static port ports[PORTS]; /* owned by core1 */
+static frame frames[FRAMES];
+static uint32_t fw,fr,led_request,errors;
+static relay_event events[EVENTS];
+static uint32_t ew,er,generation;
+static relay_state current, observed, sent;
+static uint8_t protocol=HID_PROTOCOL_REPORT, phase;
+static bool taking, online;
+static uint8_t idle_rate;
+static uint32_t last_keyboard_ms;
+static inline uint32_t load(uint32_t *p) { return __atomic_load_n(p,__ATOMIC_ACQUIRE); }
+static inline void save(uint32_t *p,uint32_t v) { __atomic_store_n(p,v,__ATOMIC_RELEASE); }
+static void error(void) { __atomic_fetch_add(&errors,1,__ATOMIC_RELAXED); }
+static port *find_port(uint8_t a,uint8_t i) {
+  for(int n=0;n<PORTS;n++) if(ports[n].active && ports[n].addr==a && ports[n].instance==i) return &ports[n];
+  return NULL;
+}
+static bool room(void) { return load(&fw)-load(&fr)<FRAMES; }
+static void snapshot(void) {
+  /* Each outstanding receive reserves one slot in the host loop. */
+  if(!room()) { error(); return; }
+  uint32_t w=load(&fw); frame *f=&frames[w%FRAMES]; memset(f,0,sizeof(*f));
+  f->ms=to_ms_since_boot(get_absolute_time()); unsigned nc=0;
+  for(int p=0;p<PORTS;p++) if(ports[p].active) for(int r=0;r<RELAY_REPORTS;r++) {
+    relay_state *s=&ports[p].reports[r];
+    for(int j=0;j<32;j++) f->state.keys[j]|=s->keys[j];
+    f->state.system|=s->system;
+    for(int j=0;j<8;j++) if(s->consumer[j]) {
+      bool exists=false; for(unsigned k=0;k<nc;k++) if(f->state.consumer[k]==s->consumer[j]) exists=true;
+      if(!exists && nc<8) f->state.consumer[nc++]=s->consumer[j];
+      else if(!exists) error();
+    }
+  }
+  save(&fw,w+1);
+}
+void tuh_hid_mount_cb(uint8_t a,uint8_t i,const uint8_t *d,uint16_t len) {
+  for(int n=0;n<PORTS;n++) if(!ports[n].active) {
+    port *p=&ports[n]; memset(p,0,sizeof(*p));
+    if(!d || !relay_parse(&p->layout,d,len)) { error(); return; }
+    p->addr=a; p->instance=i; p->active=true; p->sent_led=255;
+    return;
+  }
+  error();
+}
+static bool refresh;
+void tuh_hid_umount_cb(uint8_t a,uint8_t i) {
+  port *p=find_port(a,i); if(p) { memset(p,0,sizeof(*p)); refresh=true; }
+}
+void tuh_hid_report_received_cb(uint8_t a,uint8_t i,const uint8_t *data,uint16_t len) {
+  port *p=find_port(a,i); if(!p) return; p->pending=false;
+  uint8_t id=p->layout.numbered && len?data[0]:0;
+  int ri=-1; for(int r=0;r<p->layout.reports;r++) if(p->layout.ids[r]==id) ri=r;
+  relay_state s;
+  if(ri<0 || !relay_decode(&p->layout,data,len,&s)) { error(); return; }
+  if(memcmp(&s,&p->reports[ri],sizeof(s))) { p->reports[ri]=s; snapshot(); }
+}
+void tuh_hid_set_report_complete_cb(uint8_t a,uint8_t i,uint8_t id,uint8_t type,uint16_t len) {
+  (void)id; (void)type; port *p=find_port(a,i); if(!p) return;
+  p->led_busy=false; if(!len) { p->led_valid=false; error(); }
+}
+static void host_main(void) {
+  pio_usb_configuration_t cfg=PIO_USB_DEFAULT_CONFIG;
+  cfg.pin_dp=10; cfg.tx_ch=dma_claim_unused_channel(true);
+  tuh_configure(1,TUH_CFGID_RPI_PIO_USB_CONFIGURATION,&cfg);
+  tuh_hid_set_default_protocol(HID_PROTOCOL_REPORT);
+  tuh_init(1);
+  /* External protected supply powers the keyboard; GP12 gates its switch. */
+  gpio_init(12); gpio_set_dir(12,GPIO_OUT); gpio_put(12,1);
+  gpio_init(13); gpio_set_dir(13,GPIO_IN); gpio_pull_up(13);
+  bool power_fault=false;
+  while(true) {
+    tuh_task();
+    if(!power_fault && !gpio_get(13)) { gpio_put(12,0); power_fault=true; error(); }
+    unsigned pending=0; for(int n=0;n<PORTS;n++) pending+=ports[n].pending;
+    if(refresh && FRAMES-(load(&fw)-load(&fr))>pending) { snapshot(); refresh=false; }
+    /* Separate receives prevent an idle media endpoint starving the keyboard. */
+    for(unsigned n=0;n<PORTS;n++) {
+      port *p=&ports[n];
+      if(p->active && !p->pending && FRAMES-(load(&fw)-load(&fr))>pending &&
+         tuh_hid_receive_ready(p->addr,p->instance)) {
+        p->pending=tuh_hid_receive_report(p->addr,p->instance); pending+=p->pending;
+      }
+    }
+    for(int n=0;n<PORTS;n++) {
+      port *p=&ports[n]; uint8_t leds=load(&led_request);
+      if(!p->active || p->led_busy || (p->led_valid && p->sent_led==leds)) continue;
+      for(int r=0;r<p->layout.reports;r++) {
+        uint8_t id=p->layout.ids[r]; size_t len=relay_led_report(&p->layout,id,leds,p->led_buf);
+        if(!len) continue;
+        if(tuh_hid_set_report(p->addr,p->instance,id,HID_REPORT_TYPE_OUTPUT,p->led_buf,len)) {
+          p->led_busy=true; p->sent_led=leds; p->led_valid=true;
+        }
+        break;
+      }
+    }
+    tight_loop_contents();
+  }
+}
+static uint32_t host_stack[2048];
+void relay_start(void) { multicore_launch_core1_with_stack(host_main,host_stack,sizeof(host_stack)); }
+static void observe(uint32_t ms) {
+  uint8_t mods=current.keys[28];
+  for(unsigned u=4;u<224;u++) if((current.keys[u/8]&~observed.keys[u/8])&(1u<<(u%8))) {
+    uint32_t w=load(&ew);
+    if(w-load(&er)==EVENTS) { __atomic_fetch_add(&generation,1,__ATOMIC_RELEASE); continue; }
+    events[w%EVENTS]=(relay_event){ms,load(&generation),u,mods}; save(&ew,w+1);
+  }
+  observed=current;
+}
+static bool keyboard_send(void) {
+  if(!tud_hid_n_ready(0)) return false;
+  uint8_t boot[8];
+  if(protocol==HID_PROTOCOL_BOOT) { relay_boot_report(&current,boot); return tud_hid_n_report(0,0,boot,8); }
+  return tud_hid_n_report(0,0,current.keys,32);
+}
+void relay_device_task(void) {
+  bool mounted=tud_mounted();
+  if(!mounted) {
+    save(&fr,load(&fw)); taking=false; online=false; memset(&current,0,sizeof(current));
+    memset(&observed,0,sizeof(observed)); return;
+  }
+  if(!online) { save(&fr,load(&fw)); online=true; taking=true; phase=0; memset(&sent,255,sizeof(sent)); }
+  if(tud_suspended()) {
+    if(load(&fw)!=load(&fr)) tud_remote_wakeup();
+    return;
+  }
+  uint32_t r=load(&fr);
+  if(!taking && r!=load(&fw)) {
+    current=frames[r%FRAMES].state; observe(frames[r%FRAMES].ms);
+    save(&fr,r+1); phase=0; taking=true;
+  }
+  if(taking) {
+    if(phase==0 && (!memcmp(sent.keys,current.keys,32) || keyboard_send())) {
+      memcpy(sent.keys,current.keys,32); phase=1; last_keyboard_ms=to_ms_since_boot(get_absolute_time());
+    }
+    if(phase==1 && (!memcmp(sent.consumer,current.consumer,16) ||
+        (tud_hid_n_ready(2) && tud_hid_n_report(2,1,current.consumer,16)))) {
+      memcpy(sent.consumer,current.consumer,16); phase=2;
+    }
+    if(phase==2 && (sent.system==current.system ||
+        (tud_hid_n_ready(2) && tud_hid_n_report(2,2,&current.system,1)))) {
+      sent.system=current.system; phase=0; taking=false;
+    }
+  } else if(idle_rate && to_ms_since_boot(get_absolute_time())-last_keyboard_ms>=4u*idle_rate) {
+    if(keyboard_send()) last_keyboard_ms=to_ms_since_boot(get_absolute_time());
+  }
+}
+uint16_t tud_hid_get_report_cb(uint8_t i,uint8_t id,hid_report_type_t type,uint8_t *b,uint16_t len) {
+  if(type==HID_REPORT_TYPE_OUTPUT && i==0 && len) { b[0]=load(&led_request); return 1; }
+  if(type!=HID_REPORT_TYPE_INPUT) return 0;
+  const void *src=NULL; size_t n=0; uint8_t boot[8];
+  if(i==0) { src=current.keys; n=32; if(protocol==HID_PROTOCOL_BOOT) { relay_boot_report(&current,boot); src=boot; n=8; } }
+  if(i==2 && id==1) { src=current.consumer; n=16; }
+  if(i==2 && id==2) { src=&current.system; n=1; }
+  if(!src) return 0;
+  if(n>len) n=len;
+  memcpy(b,src,n); return n;
+}
+void tud_hid_set_report_cb(uint8_t i,uint8_t id,hid_report_type_t t,const uint8_t *b,uint16_t len) {
+  (void)id; if(i==0 && t==HID_REPORT_TYPE_OUTPUT && len) save(&led_request,b[0]&31);
+}
+void tud_hid_set_protocol_cb(uint8_t i,uint8_t p) {
+  if(i==0) { protocol=p; phase=0; taking=true; memset(sent.keys,255,32); }
+}
+bool tud_hid_set_idle_cb(uint8_t i,uint8_t rate) { if(i==0) idle_rate=rate; return true; }
+void tud_hid_report_complete_cb(uint8_t i,const uint8_t *r,uint16_t n) { (void)i; (void)r; (void)n; }
+bool relay_read_event(relay_event *e) {
+  uint32_t flags=save_and_disable_interrupts(); uint32_t r=load(&er);
+  bool ok=r!=load(&ew); if(ok) { *e=events[r%EVENTS]; save(&er,r+1); }
+  restore_interrupts(flags); return ok;
+}
+uint32_t relay_generation(void) { return load(&generation); }
+uint32_t relay_errors(void) { return load(&errors); }
+#endif
