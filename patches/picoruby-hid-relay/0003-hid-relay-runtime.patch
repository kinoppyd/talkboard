+#endif
 
 #include "hardware/gpio.h"
 #include "hardware/structs/ioqspi.h"
@@ -221,6 +224,9 @@ usb_pump_worker(void)
   if (mutex_try_enter(&usb_mutex, NULL)) {
     in_usb_pump = true;
     tud_task();
+#ifdef TALKBOARD_RELAY
